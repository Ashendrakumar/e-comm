# Reverse proxy for docker-compose.yml. Caddy gets and renews the HTTPS
# certificate for {$DOMAIN} automatically (ports 80 + 443 must reach this host).
# DOMAIN=localhost gives a locally-trusted dev certificate instead.

{$DOMAIN} {
	encode zstd gzip

	# Uploaded product / blog images. Django never serves these in production.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=604800"
		header X-Content-Type-Options nosniff
	}

	# Everything else, including /static/ (WhiteNoise serves it with far-future caching).
	handle {
		reverse_proxy web:8000
	}

	request_body {
		max_size 20MB
	}

	log {
		output stdout
		format console
	}
}

# Redirect the www. host to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
