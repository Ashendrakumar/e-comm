# ── TechZone environment variables ──────────────────────────────────
# Copy to ".env" and fill in real values. Never commit the real .env.
# Loaded automatically by techzone/settings/base.py (django-environ) and by
# docker-compose.yml. Local development needs none of these — `manage.py`
# defaults to techzone.settings.development.

# ── Core ────────────────────────────────────────────────────────────
# Production refuses to start without a real key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# The public domain. docker-compose derives ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
# SITE_DOMAIN and the HTTPS certificate from it. Use "localhost" to try the stack locally.
DOMAIN=shop.example.in
# Only needed when NOT using docker-compose (it sets these from DOMAIN):
# ALLOWED_HOSTS=shop.example.in,www.shop.example.in
# CSRF_TRUSTED_ORIGINS=https://shop.example.in,https://www.shop.example.in
# SITE_DOMAIN=shop.example.in
SITE_NAME=TechZone

# Admin URL path — pick something non-obvious (default "admin/").
ADMIN_URL=admin/

# ── Database (PostgreSQL in production) ─────────────────────────────
DB_NAME=techzone
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Cache / sessions / rate-limit counters ──────────────────────────
# docker-compose sets this to its redis service.
# REDIS_URL=redis://localhost:6379/0

# ── Email (enquiry notifications + error reports) ───────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=TechZone <noreply@shop.example.in>
# Who gets emailed when a page crashes (500): "Name <a@x.com>,b@y.com"
ADMINS=

# ── Error tracking (optional) ───────────────────────────────────────
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Abuse protection ────────────────────────────────────────────────
# Per client IP and form: N submissions per window (s/m/h/d).
RATELIMIT_FORMS=10/10m
RATELIMIT_LOGIN=10/15m
# Reverse proxies in front of Django (docker-compose: Caddy = 1).
# TRUSTED_PROXY_COUNT=1

# ── Security ────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
# Start lower (e.g. 3600) on a brand-new domain, raise to 31536000 once HTTPS is confirmed.
SECURE_HSTS_SECONDS=31536000
# Content-Security-Policy; set CSP_REPORT_ONLY=True to test a change without blocking anything.
CSP_ENABLED=True
CSP_REPORT_ONLY=False
LOG_LEVEL=INFO

# ── Product image import (Admin -> Products -> Import images) ───────
# PRODUCT_IMAGES_DIR=G:\My Drive\Product Images
