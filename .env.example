# ── TechZone environment variables ──────────────────────────────────
# Copy to ".env" and fill in real values. Never commit the real .env.
# Loaded automatically in techzone/settings/base.py via django-environ.

# Settings module: techzone.settings.development | techzone.settings.production
DJANGO_SETTINGS_MODULE=techzone.settings.development

# ── Core ────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database — SQLite by default (dev). Set these for PostgreSQL (prod): ──
DB_NAME=techzone
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Cache / sessions (optional; enables Redis in production) ─────────
REDIS_URL=redis://localhost:6379/0
CACHE_MIDDLEWARE_SECONDS=300

# ── Email ───────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=TechZone <noreply@techzone.in>

# ── Security (production) ───────────────────────────────────────────
# Comma-separated, e.g. https://techzone.in,https://www.techzone.in
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
